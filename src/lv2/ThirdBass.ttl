@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<urn:antigravity:thirdbass>
    a lv2:Plugin, lv2:AmplifierPlugin, lv2:DistortionPlugin ;
    doap:name "Third Bass" ;
    doap:license <http://opensource.org/licenses/ISC> ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "In L"
    ] , [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "In R"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Out L"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Out R"
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "in_gain" ;
        lv2:name "Input Gain" ;
        lv2:default 0.0 ;
        lv2:minimum -24.0 ;
        lv2:maximum 24.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "gate_thresh" ;
        lv2:name "Gate Threshold" ;
        lv2:default -60.0 ;
        lv2:minimum -90.0 ;
        lv2:maximum 0.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "gate_release" ;
        lv2:name "Gate Release" ;
        lv2:default 100.0 ;
        lv2:minimum 10.0 ;
        lv2:maximum 500.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "drive_enable" ;
        lv2:name "Drive Enable" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:integer ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0.0 ] ;
        lv2:scalePoint [ rdfs:label "On" ; rdf:value 1.0 ]
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "drive_mode" ;
        lv2:name "Drive Mode" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:portProperty lv2:integer ;
        lv2:scalePoint [ rdfs:label "Warm Tube" ; rdf:value 0.0 ] ;
        lv2:scalePoint [ rdfs:label "Overdrive" ; rdf:value 1.0 ] ;
        lv2:scalePoint [ rdfs:label "Fuzz Grit" ; rdf:value 2.0 ]
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "drive_amount" ;
        lv2:name "Drive Amount" ;
        lv2:default 25.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "drive_tone" ;
        lv2:name "Drive Tone" ;
        lv2:default 0.0 ;
        lv2:minimum -100.0 ;
        lv2:maximum 100.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "drive_mix" ;
        lv2:name "Drive Mix" ;
        lv2:default 70.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "eq_enable" ;
        lv2:name "EQ Enable" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:integer ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0.0 ] ;
        lv2:scalePoint [ rdfs:label "On" ; rdf:value 1.0 ]
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "eq_bass" ;
        lv2:name "Bass (80Hz)" ;
        lv2:default 2.0 ;
        lv2:minimum -15.0 ;
        lv2:maximum 15.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "eq_low_mid" ;
        lv2:name "Low Mid (350Hz)" ;
        lv2:default 1.0 ;
        lv2:minimum -15.0 ;
        lv2:maximum 15.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "eq_high_mid" ;
        lv2:name "Hi Mid (1.8kHz)" ;
        lv2:default 0.0 ;
        lv2:minimum -15.0 ;
        lv2:maximum 15.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "eq_treble" ;
        lv2:name "Treble (4.5kHz)" ;
        lv2:default 1.0 ;
        lv2:minimum -15.0 ;
        lv2:maximum 15.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ;
        lv2:symbol "sub_enable" ;
        lv2:name "Sub Enhancer" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:integer ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0.0 ] ;
        lv2:scalePoint [ rdfs:label "On" ; rdf:value 1.0 ]
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 18 ;
        lv2:symbol "sub_freq" ;
        lv2:name "Sub Frequency" ;
        lv2:default 65.0 ;
        lv2:minimum 40.0 ;
        lv2:maximum 120.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 19 ;
        lv2:symbol "sub_harmonics" ;
        lv2:name "Sub Harmonics" ;
        lv2:default 40.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 20 ;
        lv2:symbol "sub_level" ;
        lv2:name "Sub Boost" ;
        lv2:default 30.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 21 ;
        lv2:symbol "comp_enable" ;
        lv2:name "Comp Enable" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:integer ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0.0 ] ;
        lv2:scalePoint [ rdfs:label "On" ; rdf:value 1.0 ]
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 22 ;
        lv2:symbol "comp_thresh" ;
        lv2:name "Comp Threshold" ;
        lv2:default -18.0 ;
        lv2:minimum -40.0 ;
        lv2:maximum 0.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 23 ;
        lv2:symbol "comp_ratio" ;
        lv2:name "Comp Ratio" ;
        lv2:default 4.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 12.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 24 ;
        lv2:symbol "comp_attack" ;
        lv2:name "Comp Attack" ;
        lv2:default 15.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 100.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 25 ;
        lv2:symbol "comp_release" ;
        lv2:name "Comp Release" ;
        lv2:default 150.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 1000.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 26 ;
        lv2:symbol "comp_makeup" ;
        lv2:name "Comp Makeup" ;
        lv2:default 3.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 24.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 27 ;
        lv2:symbol "chorus_enable" ;
        lv2:name "Chorus Enable" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:integer ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0.0 ] ;
        lv2:scalePoint [ rdfs:label "On" ; rdf:value 1.0 ]
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 28 ;
        lv2:symbol "chorus_rate" ;
        lv2:name "Chorus Rate" ;
        lv2:default 0.8 ;
        lv2:minimum 0.1 ;
        lv2:maximum 5.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 29 ;
        lv2:symbol "chorus_depth" ;
        lv2:name "Chorus Depth" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 30 ;
        lv2:symbol "chorus_crossover" ;
        lv2:name "Chorus Crossover" ;
        lv2:default 180.0 ;
        lv2:minimum 80.0 ;
        lv2:maximum 400.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 31 ;
        lv2:symbol "chorus_mix" ;
        lv2:name "Chorus Mix" ;
        lv2:default 40.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 32 ;
        lv2:symbol "delay_enable" ;
        lv2:name "Delay Enable" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:integer ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0.0 ] ;
        lv2:scalePoint [ rdfs:label "On" ; rdf:value 1.0 ]
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 33 ;
        lv2:symbol "delay_time" ;
        lv2:name "Delay Time" ;
        lv2:default 350.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 1000.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 34 ;
        lv2:symbol "delay_feedback" ;
        lv2:name "Delay Feedback" ;
        lv2:default 35.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 90.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 35 ;
        lv2:symbol "delay_damp" ;
        lv2:name "Delay Damping" ;
        lv2:default 4000.0 ;
        lv2:minimum 1000.0 ;
        lv2:maximum 16000.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 36 ;
        lv2:symbol "delay_mix" ;
        lv2:name "Delay Mix" ;
        lv2:default 25.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 37 ;
        lv2:symbol "cab_mode" ;
        lv2:name "Cabinet Model" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 4.0 ;
        lv2:portProperty lv2:integer ;
        lv2:scalePoint [ rdfs:label "Direct / Bypass" ; rdf:value 0.0 ] ;
        lv2:scalePoint [ rdfs:label "Classic 8x10 SVT" ; rdf:value 1.0 ] ;
        lv2:scalePoint [ rdfs:label "Vintage 1x15 Portaflex" ; rdf:value 2.0 ] ;
        lv2:scalePoint [ rdfs:label "Modern 4x10 Punch" ; rdf:value 3.0 ] ;
        lv2:scalePoint [ rdfs:label "Aggressive 2x12 Rock" ; rdf:value 4.0 ]
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 38 ;
        lv2:symbol "limiter_enable" ;
        lv2:name "Peak Limiter" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:integer ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0.0 ] ;
        lv2:scalePoint [ rdfs:label "On" ; rdf:value 1.0 ]
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 39 ;
        lv2:symbol "out_gain" ;
        lv2:name "Output Gain" ;
        lv2:default 0.0 ;
        lv2:minimum -24.0 ;
        lv2:maximum 12.0
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 40 ;
        lv2:symbol "dry_wet" ;
        lv2:name "Mix (Dry/Wet)" ;
        lv2:default 100.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0
    ] .
